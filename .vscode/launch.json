{
  // The mods are injected libraries. Attach to the running game after loading a dev build
  // so its RelWithDebInfo PDBs match the loaded binaries.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to game (MSVC)",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
