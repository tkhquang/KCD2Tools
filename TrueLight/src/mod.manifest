<kcd_mod>
  <info>
    <name>True Light - Real Torch Shadows</name>
    <modid>true_light</modid>
    <description>The torch Henry holds lights the world from its flame and casts real shadows, his own body's included. For third person (TPVCamera or any camera mod), photo mode and, if you like, first person.</description>
    <author>tkhquang</author>
    <version>1.0.0</version>
    <created_on>2026-10-26</created_on>
    <modifies_level>false</modifies_level>
  </info>
</kcd_mod>
