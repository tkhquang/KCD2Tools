# EditorConfig for HenrySenses (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Data and config files conventionally use two-space indentation.
[*.{yml,yaml,json}]
indent_size = 2

# C++ sources follow the 120-column baseline codified in .clang-format.
[*.{cpp,hpp,h}]
max_line_length = 120

# Markdown uses trailing whitespace for hard line breaks.
[*.md]
trim_trailing_whitespace = false
